---
import SiteLayout from "../layouts/SiteLayout.astro";
import { portfolio } from "../portfolio.config";
import { asset } from "../utils/portfolio";
---
<SiteLayout title="关于"><div class="about-page"><header class="page-heading"><p class="page-kicker">屏幕的另一边</p><h1>关于我<span class="heading-dot">.</span></h1><p>一个记录作品，也记录成长的地方。</p></header><section class="about-card"><div class="about-intro"><img src={asset(portfolio.avatar)} width="76" height="76" alt={`${portfolio.name}的头像`}/><div><h2>{portfolio.name}</h2><p>{portfolio.tagline}</p></div></div><p>{portfolio.about}</p><p>{portfolio.introduction}</p><h3>我关注的方向</h3><div class="tags">{portfolio.interests.map(interest => <span>{interest}</span>)}</div>{(portfolio.github || portfolio.email) && <><h3>保持联系</h3><div class="about-links">{portfolio.github && <a class="text-link" href={portfolio.github} target="_blank" rel="noreferrer">GitHub ↗</a>}{portfolio.email && <a class="text-link" href={`mailto:${portfolio.email}`}>邮件联系 ↗</a>}</div></>}</section></div></SiteLayout>
