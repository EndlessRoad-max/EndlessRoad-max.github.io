---
import SiteLayout from "../layouts/SiteLayout.astro";
import EmailContact from "../components/portfolio/EmailContact.astro";
import ProjectCard from "../components/portfolio/ProjectCard.astro";
import NoteRow from "../components/portfolio/NoteRow.astro";
import HandwrittenMotto from "../components/portfolio/HandwrittenMotto.astro";
import { portfolio } from "../portfolio.config";
import { publishedNotes, publishedProjects } from "../utils/portfolio";
import { url } from "../utils/url-utils";

const projects = (await publishedProjects()).filter(p => p.data.featured).slice(0, 4);
const notes = (await publishedNotes()).slice(0, 6);
---
<SiteLayout home>
  <div class="home-cover">
    <div class="cover-identity">
  <HandwrittenMotto />
  <section class="hero" aria-label="个人介绍">
    <p class="hello">你好，我是</p>
    <h1>{portfolio.name}</h1>
    <p class="hero-subtitle">{portfolio.tagline}</p>
    <div class="actions">
      <a class="button primary" href={url("/notes/")}>进入笔记</a>
      <a class="button secondary" href={url("/projects/")}>查看项目</a>
    </div>
  </section>

    </div>
    <a class="scroll-cue" href="#home-introduction">
      <span class="scroll-cue-label">向下探索</span>
      <span class="scroll-cue-ring" aria-hidden="true">
        <svg viewBox="0 0 48 36" width="48" height="36" fill="none" focusable="false">
          <path class="cue-chevron" d="m4 8 20 12 20-12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>
  </div>

  <section class="intro-section" aria-labelledby="home-introduction">
    <h2 id="home-introduction" tabindex="-1">关于这个空间</h2>
    <p>{portfolio.introduction}</p>
    <p>{portfolio.about}</p>
    <a class="text-link" href={url("/about/")}>更多关于我 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <h2>最近的笔记</h2>
      <a class="text-link" href={url("/notes/")}>全部笔记</a>
    </div>
    <div class="notes-paper">
      {notes.map(post => <NoteRow post={post} />)}
      {!notes.length && <p class="empty-state">第一篇笔记正在路上。</p>}
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <h2>精选项目</h2>
      <a class="text-link" href={url("/projects/")}>全部项目</a>
    </div>
    <div class="project-grid">
      {projects.map(project => <ProjectCard project={project} />)}
    </div>
    {!projects.length && <p class="empty-state">作品正在整理中，欢迎先看看笔记。</p>}
  </section>

  <section class="connect-section">
    <h2>保持联系</h2>
    <div class="connect-links">
      {portfolio.github && <a href={portfolio.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
      {portfolio.email && <EmailContact email={portfolio.email} />}
      <a href={url("/rss.xml")}>RSS 订阅 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>

<script>
  const scrollCue = document.querySelector<HTMLAnchorElement>(".scroll-cue");
  let cueFrame = 0;
  const updateCueVisibility = () => {
    cueFrame = 0;
    if (!scrollCue) return;
    // Short/zoomed covers may exceed the viewport: let the cue enter view
    // before beginning to fade it out.
    const cueBottom = scrollCue.getBoundingClientRect().bottom + window.scrollY;
    const fadeStart = Math.max(24, cueBottom + 12 - window.innerHeight);
    const fadeEnd = fadeStart + Math.min(136, Math.max(96, window.innerHeight * .18 - 24));
    const opacity = Math.max(0, Math.min(1, (fadeEnd - Math.max(0, window.scrollY)) / (fadeEnd - fadeStart)));
    scrollCue.style.setProperty("--cue-opacity", String(opacity));
    const hidden = opacity === 0;
    scrollCue.toggleAttribute("data-cue-hidden", hidden);
    scrollCue.inert = hidden;
    if (hidden) scrollCue.setAttribute("aria-hidden", "true");
    else scrollCue.removeAttribute("aria-hidden");
  };
  const scheduleCueVisibility = () => {
    if (!cueFrame) cueFrame = requestAnimationFrame(updateCueVisibility);
  };
  window.addEventListener("scroll", scheduleCueVisibility, { passive: true });
  window.addEventListener("resize", scheduleCueVisibility);
  window.addEventListener("pageshow", scheduleCueVisibility);
  updateCueVisibility();
  const releaseCue = () => scrollCue?.removeAttribute("data-pressed");
  scrollCue?.addEventListener("pointerdown", event => {
    if (event.pointerType !== "mouse") scrollCue.dataset.pressed = "true";
  });
  window.addEventListener("pointerup", releaseCue);
  window.addEventListener("pointercancel", releaseCue);
  window.addEventListener("blur", releaseCue);
</script>
