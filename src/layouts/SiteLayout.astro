---
import "../styles/portfolio.css";
import DaylightScene from "../components/portfolio/DaylightScene.astro";
import { portfolio } from "../portfolio.config";
import { url } from "../utils/url-utils";
interface Props { title?: string; description?: string; home?: boolean; wide?: boolean; }
const { title, description = portfolio.introduction, home = false, wide = false } = Astro.props;
const links = [["首页", "/"], ["项目", "/projects/"], ["笔记", "/notes/"], ["关于", "/about/"]];
const path = Astro.url.pathname;
const stars = home ? Array.from({ length: 140 }, () => ({
  x: (Math.random() * 100).toFixed(2),
  size: (0.6 + Math.random() ** 3 * 1.6).toFixed(2),
  opacity: (0.18 + Math.random() ** 2 * 0.65).toFixed(2),
  duration: (55 + Math.random() * 60).toFixed(2),
  delay: (-Math.random() * 60).toFixed(2),
  rest: (Math.random() * 100).toFixed(2),
})) : [];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171717" />
    <title>{title ? `${title} · ${portfolio.siteName}` : `${portfolio.siteName} · 一直在路上`}</title>
    <link rel="icon" type="image/svg+xml" href={url("/images/star-favicon.svg") + "?v=3"} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="笔记订阅" href={url("/rss.xml")} />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme") || "auto";
        document.documentElement.classList.toggle("dark", theme === "dark" || (theme === "auto" && matchMedia("(prefers-color-scheme: dark)").matches));
      } catch { document.documentElement.classList.toggle("dark", matchMedia("(prefers-color-scheme: dark)").matches); }
      document.documentElement.dataset.theme = "github-dark";
    </script>
  </head>
  <body class:list={{ "home-page": home }}>
    {home && <DaylightScene />}
    {home && <div class="sphere-sky" aria-hidden="true"><div class="star-field">{stars.map(star => <span class="star-particle" style={`--x:${star.x}%;--size:${star.size}px;--alpha:${star.opacity};--duration:${star.duration}s;--delay:${star.delay}s;--rest:${star.rest}%`}></span>)}</div><div class="sphere-horizon"></div><div class="lunar-surface"><picture><source media="(max-width: 639px)" srcset={url("/images/lunar-horizon-mobile.webp")} /><img src={url("/images/lunar-horizon.webp")} width="1536" height="1024" alt="" decoding="async" fetchpriority="high" /></picture></div><div class="lunar-shade"></div></div>}
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url("/")} aria-label={`${portfolio.siteName} 首页`}><svg class="brand-symbol brand-star" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2 Q13.5 10.5 22 12 Q13.5 13.5 12 22 Q10.5 13.5 2 12 Q10.5 10.5 12 2Z"/></svg>{portfolio.siteName}</a>
        <nav aria-label="主导航">{links.map(([label, href]) => <a href={url(href)} aria-current={(href === "/" ? path === url(href) : path.startsWith(url(href)) || (href === "/notes/" && path.startsWith(url("/posts/")))) ? "page" : undefined}>{label}</a>)}</nav>
        <div class="header-tools">
          <a class="search-link" href={url("/search/")} aria-label="搜索笔记和项目"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><span>搜索</span></a>
          <button id="theme-toggle" class="icon-button" aria-label="切换明暗主题" title="切换明暗主题">
            <svg class="theme-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
            <svg class="theme-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class:list={["site-main", { "site-main-wide": wide }]}><slot /></main>
    <footer class="site-footer"><div><a class="footer-brand" href={url("/")}>{portfolio.siteName}</a><span>一直在路上，想看看前面还有什么</span></div><div><a href={url("/rss.xml")}>RSS 订阅</a><span>© {new Date().getFullYear()} {portfolio.name}</span></div></footer>
    <script>
      import { applyThemeToDocument, getStoredTheme, setTheme } from "../utils/setting-utils";
      const sky = document.querySelector<HTMLElement>(".sphere-sky");
      const moon = sky?.querySelector<HTMLImageElement>(".lunar-surface img");
      if (moon) {
        const revealMoon = () => moon.decode().then(() => moon.classList.add("is-ready")).catch(() => moon.classList.remove("is-ready"));
        moon.addEventListener("load", revealMoon);
        moon.addEventListener("error", () => moon.classList.remove("is-ready"));
        if (moon.complete) revealMoon();
      }
      const daylight = document.querySelector<HTMLElement>(".daybreak-sky");
      let sceneVisible = true;
      const updateSceneActivity = () => {
        const paused = !sceneVisible || document.hidden;
        sky?.classList.toggle("sky-paused", paused);
        daylight?.classList.toggle("sky-paused", paused);
      };
      if (sky && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(([entry]) => {
          sceneVisible = entry.isIntersecting;
          updateSceneActivity();
        });
        observer.observe(sky);
      }
      document.addEventListener("visibilitychange", updateSceneActivity);
      updateSceneActivity();
      const header = document.querySelector<HTMLElement>(".site-header")!;
      const cover = document.querySelector<HTMLElement>(".home-cover");
      const syncCoverGeometry = () => {
        if (!cover) return;
        const body = document.body;
        const headerHeight = header.offsetHeight;
        const scale = header.getBoundingClientRect().height / headerHeight || 1;
        body.style.setProperty("--header-height", `${headerHeight}px`);
        body.style.setProperty("--scene-height", `${headerHeight + cover.offsetHeight}px`);
        const name = cover.querySelector("h1");
        if (name) body.style.setProperty("--moon-crest", `${(name.getBoundingClientRect().top + window.scrollY) / scale - 40}px`);
      };
      if (cover) {
        syncCoverGeometry();
        const coverObserver = new ResizeObserver(syncCoverGeometry);
        coverObserver.observe(header);
        coverObserver.observe(cover);
        window.addEventListener("resize", syncCoverGeometry);
        window.addEventListener("pageshow", syncCoverGeometry);
      }
      const updateHeader = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });
      window.addEventListener("pageshow", updateHeader);
      const button = document.querySelector<HTMLButtonElement>("#theme-toggle")!;
      const root = document.documentElement;
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      let cleanupTimer: ReturnType<typeof setTimeout>;
      let sceneFrame = 0;
      let sceneProgress = root.classList.contains("dark") ? 1 : 0;
      let sceneTarget = sceneProgress;
      function paintScene(progress: number) {
        sceneProgress = progress;
        root.style.setProperty("--night-progress", String(progress));
        root.style.setProperty("--curtain-edge", `${-35 + progress * 170}%`);
      }
      if (sky) paintScene(sceneProgress);
      function animateScene(target: number, duration: number) {
        cancelAnimationFrame(sceneFrame);
        sceneTarget = target;
        const from = sceneProgress;
        const started = performance.now();
        const travel = duration * Math.abs(target - from);
        const tick = (now: number) => {
          const t = travel ? Math.min(1, (now - started) / travel) : 1;
          const eased = t * t * (3 - 2 * t);
          paintScene(from + (target - from) * eased);
          if (t < 1) sceneFrame = requestAnimationFrame(tick);
          else finishTransition();
        };
        sceneFrame = requestAnimationFrame(tick);
      }
      let manualTheme: "light" | "dark" | undefined;
      function label() {
        const text = root.classList.contains("dark") ? "切换到浅色主题" : "切换到深色主题";
        button.setAttribute("aria-label", text);
        button.title = text;
      }
      function finishTransition() {
        clearTimeout(cleanupTimer);
        root.removeAttribute("data-theme-changing");
        root.classList.remove("lunar-transition");
      }
      function prepareTransition(manual: boolean, target: number) {
        clearTimeout(cleanupTimer);
        const bounds = sky?.getBoundingClientRect();
        const lunar = manual && !reducedMotion.matches && bounds && bounds.bottom > 0 && bounds.top < innerHeight;
        root.classList.add("theme-transitions");
        root.classList.toggle("lunar-transition", Boolean(lunar));
        root.dataset.themeChanging = "true";
        if (sky) animateScene(target, reducedMotion.matches ? 0 : lunar ? 1100 : 300);
        else cleanupTimer = setTimeout(finishTransition, reducedMotion.matches ? 0 : 300);
      }
      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) {
          cancelAnimationFrame(sceneFrame);
          if (sky) paintScene(sceneTarget);
          finishTransition();
        }
      });
      label();
      button.addEventListener("click", () => {
        const next = document.documentElement.classList.contains("dark") ? "light" : "dark";
        prepareTransition(true, next === "dark" ? 1 : 0);
        manualTheme = next;
        try { setTheme(next); } catch { applyThemeToDocument(next); }
        label();
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        let automatic = !manualTheme;
        try { automatic = !manualTheme && getStoredTheme() === "auto"; } catch { /* Keep the in-memory preference when storage is unavailable. */ }
        if (!automatic) return;
        prepareTransition(false, matchMedia("(prefers-color-scheme: dark)").matches ? 1 : 0);
        applyThemeToDocument("auto");
        label();
      });
    </script>
  </body>
</html>
