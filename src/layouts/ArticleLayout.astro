---
import type { MarkdownHeading } from "astro";
import SiteLayout from "./SiteLayout.astro";
import Markdown from "../components/misc/Markdown.astro";
import TOC from "../components/widget/TOC.astro";
import { url } from "../utils/url-utils";
import { asset } from "../utils/portfolio";
interface Props { title: string; description: string; headings: MarkdownHeading[]; kind: "项目" | "笔记"; image?: string; }
const { title, description, headings, kind, image } = Astro.props;
const back = kind === "项目" ? "/projects/" : "/notes/";
---
<SiteLayout wide title={title} description={description}><div class="article-grid"><article class="article-panel" data-pagefind-body><a class="breadcrumb" href={url(back)} data-pagefind-ignore>返回{kind}</a><h1 data-pagefind-meta="title">{title}</h1><p class="article-description">{description}</p><slot name="meta" />{image && <img class="article-cover" src={asset(image)} alt={`${title}预览`} width="760" height="428" />}{headings.length > 0 && <details class="mobile-toc" data-pagefind-ignore><summary>本页目录</summary>{headings.filter(h => h.depth <= 3).map(h => <a href={`#${h.slug}`}>{h.text.replace(/#$/, "")}</a>)}</details>}<Markdown class="article-body"><slot /></Markdown><div class="article-bottom" data-pagefind-ignore><a class="text-link" href={url(back)}>继续浏览{kind}</a></div></article><aside id="toc" class="toc-sidebar" aria-label="文章目录" data-pagefind-ignore>{headings.length > 0 && <><h2>本页目录</h2><div id="toc-inner-wrapper"><TOC headings={headings} /></div></>}</aside></div></SiteLayout>
