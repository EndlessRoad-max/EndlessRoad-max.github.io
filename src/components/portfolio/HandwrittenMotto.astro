---
import lettering from '../../assets/handwriting/great-vibes.json';
import chineseArt from '../../assets/handwriting/chinese-art.json';
const chinese = chineseArt as Record<string, string[]>;
const translation = '一直在路上，想看看前面还有什么。';
const glyphs = lettering.glyphs as Record<string, {outline:string;paths:string[];maskWidth:number;advance:number}>;
---
<section class="handwritten-motto" aria-label="一直在路上，想看看前面还有什么。 Still curious. Still moving forward.">
  <p class="motto-accessible" lang="en">Still curious. Still moving forward.</p>
  <div class="motto-english" aria-hidden="true">
    {lettering.lines.map((line, lineIndex) => <span class="motto-en-line" style={`--ink-width:${(line.width+280)/lettering.units}`}>
      <svg viewBox={`-140 -1000 ${line.width+280} 1450`} focusable="false">
        {line.letters.map((letter,index) => {
          const glyph=glyphs[letter.char];
          const id=`english-ink-${lineIndex}-${index}`;
          return <g transform={`translate(${letter.x},0)`}>
            <defs><mask id={id} maskUnits="userSpaceOnUse" x="-500" y="-1500" width="2500" height="2500">
              {glyph.paths.map(d => <path class="motto-pen" data-script="en" d={d} pathLength="1" fill="none" stroke="white" stroke-width={glyph.maskWidth} stroke-linecap="round" stroke-linejoin="round" />)}
            </mask></defs>
            <path class="motto-ink" d={glyph.outline} fill="currentColor" mask={`url(#${id})`} />
          </g>;
        })}
      </svg>
    </span>)}
  </div>
  <p class="motto-translation" aria-label="中文题词">
    <span class="motto-accessible">{translation}</span>
    <span class="motto-chinese-art" aria-hidden="true">
      {[...translation].map(char => <svg viewBox="0 0 1024 1024" focusable="false">
        {chinese[char] ? <g transform="scale(1,-1) translate(0,-900)" fill="currentColor">{chinese[char].map(d => <path d={d} />)}</g>
          : <path d={char==='，'?'M390 740 Q450 800 350 880':'M430 760 A55 55 0 1 1 429 760'} stroke="currentColor" stroke-width="46" stroke-linecap="round" fill="none" />}
      </svg>)}
    </span>
    <svg class="motto-light" aria-hidden="true" viewBox="0 0 20 20" focusable="false"><path d="M10 0 Q11 9 20 10 Q11 11 10 20 Q9 11 0 10 Q9 9 10 0" fill="currentColor" /></svg>
  </p>
</section>

<script>
  const motto = document.querySelector<HTMLElement>('.handwritten-motto');
  if (motto) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let animations: Animation[] = [];
    let generation = 0;
    const finish = () => {
      generation++;
      animations.forEach(animation => animation.cancel());
      animations = [];
      motto.dataset.state = 'complete';
    };
    const play = () => {
      finish();
      if (motion.matches || window.scrollY > 8) return;
      const current = generation;
      try {
        let delay = 200;
        const paths = [...motto.querySelectorAll<SVGPathElement>('[data-script="en"]')];
        const lengths = paths.map(p => Math.max(8, p.getTotalLength()));
        const sum = lengths.reduce((a,b) => a+b,0);
        paths.forEach((path, i) => {
          const duration = 6900 * lengths[i] / sum;
          animations.push(path.animate([
            {strokeDashoffset:1,opacity:0,offset:0},
            {strokeDashoffset:0.999,opacity:1,offset:0.001},
            {strokeDashoffset:0,opacity:1,offset:1},
          ], {duration, delay, fill:'both', easing:'linear'}));
          delay += duration;
        });
        const translation = motto.querySelector('.motto-translation')!;
        animations.push(translation.animate([{opacity:0,transform:'translateY(6px)'},{opacity:1,transform:'translateY(0)'}],{duration:750,delay:delay+150,fill:'both',easing:'ease-out'}));
        motto.dataset.state = 'writing';
        Promise.all(animations.map(a => a.finished)).then(() => {if(current===generation) finish();}).catch(() => {});
      } catch { finish(); }
    };
    motion.addEventListener('change', () => {if(motion.matches) finish();});
    window.addEventListener('pageshow', event => {if(event.persisted) play();});
    play();
  }
</script>
